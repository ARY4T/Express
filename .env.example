# MongoDB Atlas credentials
MONGO_USER=your_mongo_username
MONGO_PASSWORD=your_mongo_password
MONGO_DEFAULT_DATABASE=shop

# Stripe secret key (test or live)
STRIPE_KEY=sk_test_xxxxx

# SendGrid API key for transactional emails
SENDGRID_API_KEY=SG.xxxxx

# Session secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_random_64_char_hex_string

# CSRF secret — generate the same way as session secret
CSRF_SECRET=replace_with_another_random_64_char_hex_string

# Environment
NODE_ENV=development
PORT=3000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=